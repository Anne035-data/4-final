pipeline {
    agent any
    environment {
        AWS_ACCESS_KEY_ID     = credentials('AWS_ACCESS_KEY_ID')
        AWS_SECRET_ACCESS_KEY = credentials('AWS_SECRET_ACCESS_KEY')
        NEON_DATABASE_URL     = credentials('NEON_DATABASE_URL')
        EVIDENTLY_CLOUD_TOKEN = credentials('EVIDENTLY_CLOUD_TOKEN')
        S3_BUCKET             = '4-final-project'
    }
    stages {
        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/Anne035-data/4-final.git'
            }
        }
        stage('Exécuter les contrôles d\'environnement') {
            steps {
                sh '''
                    cd tests
                    python3 check_environment.py
                '''
            }
        }
    }
    post {
        success {
            echo '✅ Environnement vérifié avec succès'
        }
        failure {
            echo '❌ Des problèmes ont été détectés dans l\'environnement'
        }
    }
}